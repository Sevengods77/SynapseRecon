# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg

# Environments
.env
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Logs & temp
*.log
*.tmp

# OS
.DS_Store
Thumbs.db

# Large model/data files (we track these in this repo for portability)
# *.pt (moved to checkpoints)
# *.ckpt (moved to checkpoints)
!checkpoints/*.pt
!checkpoints/*.ckpt
!checkpoints/**/*.ckpt

# User-supplied images in master_images/ (do not commit personal photos)
master_images/*
!master_images/.gitkeep

# ChromaDB generated data
vector_db/

# Always keep folder placeholders
!.gitkeep
